# Production Environment Configuration for Mubsat AI Platform
# Copy this file to .env on your production server and fill in the values

# Environment
NODE_ENV=production

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Database Configuration (PostgreSQL on Hostinger VPS)
DATABASE_URL=postgresql://mubsat_ai_user:YOUR_STRONG_PASSWORD@localhost:5432/mubsat_ai

# Session Security
SESSION_SECRET=GENERATE_RANDOM_SECRET_HERE_USE_openssl_rand_base64_32

# Telegram Bot (Optional - only if using Telegram integration)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# AI API Keys (Add as needed)
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-gemini-api-key
HUGGINGFACE_API_KEY=hf_your-huggingface-key

# Optional: Application URL
APP_URL=https://your-domain.com

# Optional: Email Configuration (if implementing email features)
# SMTP_HOST=smtp.your-email-provider.com
# SMTP_PORT=587
# SMTP_USER=your-email@domain.com
# SMTP_PASS=your-email-password

# Optional: File Upload Configuration
# MAX_FILE_SIZE=10485760  # 10MB in bytes
